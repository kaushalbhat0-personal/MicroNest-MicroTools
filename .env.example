# NoticeFlow — Environment variables
# Copy to .env.local and fill from Supabase project settings.
# NEVER commit real values.

# Public — browser-safe (NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only — never NEXT_PUBLIC_, never exposed to browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Notes:
# - SUPABASE_SERVICE_ROLE_KEY is used only via src/infrastructure/database/supabase-service.ts (server).
# - Phase 1+ RLS will enforce tenant isolation; anon key is public by design but RLS default-deny.
